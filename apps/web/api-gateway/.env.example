# =============================================================================
# API GATEWAY ENVIRONMENT CONFIGURATION
# Phase 6: Configuration & Deployment
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
PORT=3001
NODE_ENV=development
API_VERSION=v1
FRONTEND_URL=http://localhost:3000
REQUEST_TIMEOUT=30000

# -----------------------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------------------
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h
JWT_ISSUER=api-gateway
JWT_AUDIENCE=adk-frontend

# API Keys for service-to-service authentication
VALID_API_KEYS=dev-api-key-1,dev-api-key-2
API_KEY_HEADER=X-API-Key

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
DATABASE_TYPE=sqlite
DATABASE_PATH=../Customer/database/customers.db
SALES_DATABASE_PATH=../Sales/database/sales_agent.db
INVENTORY_DATABASE_PATH=../Inventory/database/inventory.db
FINANCE_DATABASE_PATH=../Finance/database/finance.db

# PostgreSQL Configuration (alternative to SQLite)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=enterprise_data
POSTGRES_USER=api_gateway_user
POSTGRES_PASSWORD=secure_password
POSTGRES_SSL=false
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=10

# -----------------------------------------------------------------------------
# Cache Configuration
# -----------------------------------------------------------------------------
# Redis Configuration (primary cache)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=3600
REDIS_MAX_RETRIES=3

# Memory Cache Configuration (fallback)
CACHE_TTL=3600
MEMORY_CACHE_TTL=600
CACHE_KEY_PREFIX=api-gateway:
CACHE_COMPRESSION=false

# -----------------------------------------------------------------------------
# Rate Limiting Configuration
# -----------------------------------------------------------------------------
GENERAL_RATE_LIMIT_WINDOW=900000
GENERAL_RATE_LIMIT_MAX=1000
RATE_LIMIT_PREFIX=rl:

# Per-endpoint rate limits (requests per window)
RATE_LIMIT_TRANSACTION_PATTERNS=300
RATE_LIMIT_CUSTOMER_SEGMENTATION=200
RATE_LIMIT_CHURN_PREDICTION=150
RATE_LIMIT_HEALTH_CHECK=1000

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE_PATH=./logs/api-gateway.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# Request/Response Logging
LOG_REQUESTS=true
LOG_RESPONSES=false
LOG_BODY=false
LOG_HEADERS=false

# -----------------------------------------------------------------------------
# Security Configuration
# -----------------------------------------------------------------------------
# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With,X-API-Key
CORS_CREDENTIALS=true

# Security Headers
SECURITY_HELMET_ENABLED=true
SECURITY_CSP_ENABLED=true
SECURITY_HSTS_ENABLED=true

# Internal Network Configuration
INTERNAL_IPS=127.0.0.1,::1

# Request Validation
MAX_REQUEST_SIZE=50mb
MAX_JSON_SIZE=10mb

# -----------------------------------------------------------------------------
# Performance Configuration
# -----------------------------------------------------------------------------
COMPRESSION_ENABLED=true
COMPRESSION_LEVEL=6
COMPRESSION_THRESHOLD=1024

# Connection Pooling
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT=10000
DB_POOL_ACQUIRE_TIMEOUT=60000

# Query Configuration
QUERY_TIMEOUT=30000
QUERY_CACHE_SIZE=1000

# -----------------------------------------------------------------------------
# Health Check Configuration
# -----------------------------------------------------------------------------
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_FREQUENCY=30000
HEALTH_CHECK_TIMEOUT=5000

# Circuit Breaker Configuration
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=60000

# -----------------------------------------------------------------------------
# External Connector Configuration
# -----------------------------------------------------------------------------
# Salesforce Connector
SALESFORCE_BASE_URL=https://api.salesforce.com
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_SECURITY_TOKEN=
SALESFORCE_API_VERSION=58.0

# SAP Connector
SAP_API_URL=
SAP_USERNAME=
SAP_PASSWORD=
SAP_API_KEY=
SAP_AUTH_TYPE=basic
SAP_ODATA_VERSION=4.0

# -----------------------------------------------------------------------------
# Development Configuration
# -----------------------------------------------------------------------------
DEBUG_ENABLED=false
DEBUG_SQL=false
DEBUG_CACHE=false
DEBUG_AUTH=false

# Mock Data Configuration
MOCK_DATA_ENABLED=false
MOCK_DELAY_MS=100

# -----------------------------------------------------------------------------
# Deployment Configuration
# -----------------------------------------------------------------------------
DEPLOYMENT_ENV=development
DEPLOYMENT_VERSION=1.0.0
PM2_INSTANCES=max
PM2_EXEC_MODE=cluster
PM2_MAX_MEMORY_RESTART=1G

# -----------------------------------------------------------------------------
# Monitoring & Metrics
# -----------------------------------------------------------------------------
METRICS_ENABLED=true
METRICS_PREFIX=api_gateway_
AUDIT_ENABLED=true
AUDIT_LOG_PATH=./logs/audit.log

# -----------------------------------------------------------------------------
# IMPORTANT SECURITY NOTES
# -----------------------------------------------------------------------------
# 1. Change JWT_SECRET in production
# 2. Use strong passwords for database connections
# 3. Configure proper CORS origins for production
# 4. Enable SSL/TLS for external connections
# 5. Regularly rotate API keys
# 6. Never commit secrets to version control
# -----------------------------------------------------------------------------