# API Gateway Configuration for Real Agent Integration
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:3002
API_GATEWAY_URL=http://localhost:3002
API_GATEWAY_TOKEN=your_api_gateway_token
NEXT_PUBLIC_API_GATEWAY_TOKEN=your_api_gateway_token

# Optional: Development mode settings
NEXT_PUBLIC_USE_MOCK_AGENTS=false
NODE_ENV=development

# Instructions:
# 1. Copy this file to .env.local
# 2. Replace 'your_api_gateway_token' with your actual API Gateway token
# 3. Ensure your API Gateway is running on localhost:3002
# 4. Set NEXT_PUBLIC_USE_MOCK_AGENTS=true if you want to test with mock data first