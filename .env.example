# ============================================================================
# Environment Variables Template
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to Git!
# ============================================================================

# ============================================================================
# Google AI Configuration
# ============================================================================
GOOGLE_GENAI_USE_VERTEXAI=False
GOOGLE_API_KEY=your_google_gemini_api_key_here
MODEL=gemini-2.5-flash
MODEL_PROVIDER=gemini

# ============================================================================
# Deepgram API (for voice features)
# ============================================================================
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ============================================================================
# PostgreSQL Database Configuration
# ============================================================================
DB_USER=enterpriseiq
DB_PASSWORD=your_database_password
DB_HOST=localhost  # For local: localhost, For Azure: yourserver.postgres.database.azure.com
DB_PORT=5432
DB_NAME=enterpriseiq
SSL_MODE=disable  # For local: disable, For Azure: require

# ============================================================================
# Server Configuration
# ============================================================================
PORT=8000

# ============================================================================
# Frontend Configuration (apps/frontend/.env)
# ============================================================================
# Local development
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_BACKEND_AI_URL=http://localhost:8000
NEXT_PUBLIC_ADK_URL=http://localhost:8000

# Production (Azure) - update these after deployment
# NEXT_PUBLIC_API_URL=https://your-adk-backend.azurecontainerapps.io/api
# NEXT_PUBLIC_BACKEND_AI_URL=https://your-adk-backend.azurecontainerapps.io
# NEXT_PUBLIC_ADK_URL=https://your-adk-backend.azurecontainerapps.io

# ============================================================================
# Docker Compose Configuration
# ============================================================================
# These are used by docker-compose.yml
# Make sure to set GOOGLE_API_KEY and DEEPGRAM_API_KEY above
